{
  // Base directories.
  "work_dir": "./work", // Logs, caches, downloaded playlists and the AcoustID queue.
  "destination": "./destination", // Directory for completed, tagged MP3 files.
  "log_level": "INFO", // DEBUG, INFO, WARNING, ERROR or CRITICAL.

  // Discovery selects stations from the community playlist.
  "stream_keywords": ["rock", "pop", "top hits"], // Empty = all discovered stations.
  "discovery_enabled": true, // Enable automatic station discovery.
  "discovery_min_bitrate": 128, // Minimum bitrate in kbit/s. 0 = no minimum.
  "max_concurrent_streams": 200, // Maximum simultaneous recordings. Minimum: 1.
  "http_pool_size": 0, // HTTP connection pool size; 0 = follow max_concurrent_streams.
  "http_pool_timeout": 30, // Seconds a connection waits for a free pool slot.
  "http_max_keepalive": 100, // Idle keepalive connections (kept below the pool size).
  "discovery_random_sample_size": 50000, // Random entries taken from the large community playlist.

  // Network and reconnect behavior.
  "user_agent": "Radio-Ripper-Stream/2.0", // HTTP User-Agent for radio requests.
  "request_timeout": 30, // HTTP timeout in seconds.
  "reconnect_base_delay": 1.0, // Initial reconnect delay in seconds.
  "reconnect_max_delay": 60.0, // Maximum reconnect delay in seconds.
  "no_icy_disable_after": 10, // Disable a station after this many ICY-free connections.
  "ignore_title_patterns": [], // Regular expressions for titles to ignore.

  // Recording and storage limits.
  "min_file_size_bytes": 1572864, // Delete recordings smaller than this size.
  "min_file_duration_s": 90, // Delete recordings shorter than this duration in seconds.
  "max_files_inbox": 5000, // Pause recorders when destination reaches this file count.

  // Preflight and discovery probing.
  "probe_timeout": 8.0, // Startup reachability-check timeout in seconds.
  "probe_concurrent": 20, // Simultaneous startup reachability checks.
  "discovery_probe_timeout": 8.0, // Discovery check timeout in seconds.
  "discovery_max_concurrent": 300, // Simultaneous discovery checks.
  "discovery_work_station_count": 400, // Reserved discovery work pool size.

  // AcoustID fingerprinting and API retries.
  "acoustid_min_score": 0.9, // Minimum match score from 0.0 to 1.0.
  "acoustid_api_url": "https://api.acoustid.org/v2/lookup", // AcoustID lookup endpoint.
  "acoustid_requests_per_minute": 170, // Requests per minute; AcoustID maximum is 180.
  "acoustid_retry_max_attempts": 5, // Retries for temporary API failures.
  "acoustid_retry_base_delay": 30.0, // Initial retry delay in seconds.
  "acoustid_retry_max_delay": 3600.0, // Maximum retry delay in seconds.

  // Backpressure for work/unchecked_mp3.
  "max_unchecked_files": 5000, // Maximum queued files before recording pauses.
  "max_unchecked_bytes": 10737418240, // Maximum queue size in bytes. Default: 10 GiB.

  // Rotating application log.
  "log_file_max_bytes": 5242880, // Maximum log size before rotation. Default: 5 MiB.
  "log_file_backup_count": 5 // Rotated log files to retain.
}
