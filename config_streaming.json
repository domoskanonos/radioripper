{
  "destination": "/home/laptop/Musik",
  "work_dir": "./work",
  "log_level": "INFO",
  "stream_keywords": [
    "classic", "retro", "oldies", "Charts", "New-Releases",
    "50", "60", "70", "80", "90", "2000", "2010", "2020",
    "Pop", "Synth-Pop", "Indie-Pop", "Dance-Pop", "K-Pop",
    "Rock", "Classic-Rock", "Hard-Rock", "Heavy-Metal", "Alternative-Rock",
    "Indie-Rock", "Punk-Rock", "Grunge", "Progressive-Rock", "Soft-Rock",
    "Hip-Hop", "Rap", "R&B", "Soul", "Funk", "Gospel",
    "Electronic", "EDM", "House", "Techno", "Trance", "Drum-and-Bass", "Dubstep",
    "Jazz", "Blues", "Swing", "Country", "Folk", "Reggae", "Ska",
    "Classical", "Soundtracks", "Lo-Fi", "Ambient", "Chillout",
    "World-Music", "Latin-Pop", "Reggaeton", "Salsa", "Afrobeats",
    "Schlager", "Party", "Workout", "Lounge", "Synthwave"
